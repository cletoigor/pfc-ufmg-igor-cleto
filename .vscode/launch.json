{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "dagster dev",
            "type": "debugpy",
            "request": "launch",
            "module": "dagster",
            "justMyCode": false,
            "args": [
                "dev",
                "-w",
                "workspace.yaml"
            ],
            "subProcess": true,
            "cwd": "${workspaceFolder}/app",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Streamlit",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/streamlit",
            "console": "integratedTerminal",
            "env": {
                "PYTHONUNBUFFERED": "1"
            },
            "cwd": "${workspaceFolder}/app/streamlit",
            "args": [
                "run",
                "streamlit_app.py"
            ]
        }
    ]
}
